let prices: [String: Double] = [
    "Apple": 30.0,
    "Milk": 50.0,
    "Bread": 40.0,
    "Rice": 80.0
]

let cart = ["Apple", "Milk", "Bread", "Apple"]

var total = 0.0

for item in cart {
    if let price = prices[item] {
        total += price
    } else {
        print("Price not found for:", item)
    }
}

print("Items Bought:", cart)
print("Total Bill: ₹\(total)")
