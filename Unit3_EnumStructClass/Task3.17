enum Grade {
    case A, B, C, D, F
}

struct Student {
    var name: String
    var rollNumber: Int
    var marks: Int

    var grade: Grade {
        switch marks {
        case 90...100: return .A
        case 75..<90: return .B
        case 60..<75: return .C
        case 40..<60: return .D
        default: return .F
        }
    }
}

class School {
    var students: [Student] = []

    func addStudent(_ student: Student) {
        students.append(student)
    }

    func printReport() {
        let sortedStudents = students.sorted {
            $0.marks > $1.marks
        }

        print("STUDENT REPORT")
        print("--------------------")

        for student in sortedStudents {
            print("Name: \(student.name)")
            print("Roll Number: \(student.rollNumber)")
            print("Marks: \(student.marks)")
            print("Grade: \(student.grade)")
            print("--------------------")
        }
    }
}

let school = School()

school.addStudent(Student(name: "Arun", rollNumber: 101, marks: 85))
school.addStudent(Student(name: "Priya", rollNumber: 102, marks: 95))
school.addStudent(Student(name: "Kavin", rollNumber: 103, marks: 55))
school.addStudent(Student(name: "Divya", rollNumber: 104, marks: 72))

school.printReport()
