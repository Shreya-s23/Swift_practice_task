struct Student {
    var name: String
}

class Person {
    var name: String

    init(name: String) {
        self.name = name
    }
}

var s1 = Student(name: "Arun")
var s2 = s1
s2.name = "Priya"

let p1 = Person(name: "Arun")
let p2 = p1
p2.name = "Priya"

print("Struct original:", s1.name)
print("Struct copy:", s2.name)

print("Class original:", p1.name)
print("Class copy:", p2.name)

// Structs are value types, so s2 is an independent copy.
// Classes are reference types, so p1 and p2 refer to the same object.
