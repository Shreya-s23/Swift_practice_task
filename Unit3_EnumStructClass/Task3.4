struct Student {
    var name: String
    var rollNumber: Int
    var marks: Int

    func isPassed() -> Bool {
        return marks >= 40
    }
}

let s1 = Student(name: "Arun", rollNumber: 101, marks: 75)
let s2 = Student(name: "Priya", rollNumber: 102, marks: 30)

print(s1.isPassed())
